exports[`complete TUI screen map stacks mode controls without losing actions in a narrow terminal 1`] = `
"                                                            
 ╭────────────────────────────────────────────────────────╮ 
 │  ◆ JIRAFLOW / Mode Selection                       S8  │ 
 │  Saved linked issues are preserved when inactive.      │ 
 │────────────────────────────────────────────────────────│ 
 │                                                        │ 
 │ ┌────────────────────────────────────────────────────┐ │ 
 │ │ 1 Hybrid                                           │ │ 
 │ │ Saved link first, then branch                      │ │ 
 │ └────────────────────────────────────────────────────┘ │ 
 │                                                        │ 
 │ ┌────────────────────────────────────────────────────┐ │ 
 │ │ 2 Branch                                           │ │ 
 │ │ Derive the issue from the branch                   │ │ 
 │ └────────────────────────────────────────────────────┘ │ 
 │                                                        │ 
 │ ┌────────────────────────────────────────────────────┐ │ 
 │ │ 3 Manual                                           │ │ 
 │ │ Use only the saved linked issue                    │ │ 
 │ └────────────────────────────────────────────────────┘ │ 
 │                                                        │ 
 │ Changing mode never deletes the saved linked issue.    │ 
 │                                                        │ 
 │────────────────────────────────────────────────────────│ 
 │  1 Hybrid  2 Branch  3 Manual  Esc Cancel  Q Quit      │ 
 │  ? Help                                                │ 
 ╰────────────────────────────────────────────────────────╯ 
                                                            
"
`;
