{
  "name": "jira-flow",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Link git commits with Jira issues. v1 TypeScript rewrite (unpublished development branch).",
  "author": "Jaleel Bennett <jaleelcodes@gmail.com>",
  "homepage": "https://github.com/JaleelB/jira-flow",
